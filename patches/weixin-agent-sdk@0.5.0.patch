+function readPersistedContextTokens() {
+	try {
+		const parsed = JSON.parse(fs.readFileSync(resolveContextTokenPath(), "utf8"));
+		if (parsed?.version !== 1 || !Array.isArray(parsed.records)) return [];
+		return parsed.records.filter((record) => typeof record?.accountId === "string" && typeof record?.userId === "string" && typeof record?.token === "string" && Number.isFinite(record?.receivedAtMs));
+	} catch {
+		return [];
+	}
+}
+function writePersistedContextTokens(records) {
+	const tokenPath = resolveContextTokenPath();
+	const dir = path.dirname(tokenPath);
+	const tempPath = `${tokenPath}.${process.pid}.${randomUUID()}.tmp`;
+	fs.mkdirSync(dir, { recursive: true, mode: 448 });
+	try {
+		fs.writeFileSync(tempPath, `${JSON.stringify({
+			version: 1,
+			records
+		}, null, 2)}\n`, {
+			encoding: "utf8",
+			mode: 384,
+			flag: "wx"
+		});
+		fs.renameSync(tempPath, tokenPath);
+	} finally {
+		try {
+			fs.rmSync(tempPath, { force: true });
+		} catch {}
+	}
+}
